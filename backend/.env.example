DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_ATTEMPTS=3
CORS_ORIGINS=["http://localhost:10086","http://127.0.0.1:10086"]

# MySQL: business and test databases MUST be different.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=levelup
MYSQL_PASSWORD=
MYSQL_DATABASE=levelup
MYSQL_TEST_DATABASE=levelup_test
# Only the dedicated test runner uses this flag.
DATABASE_TESTING=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Generate a stable random secret; used for privacy-preserving abuse counters.
IDENTITY_HASH_SECRET=
SESSION_DAYS=7
QUIZ_DAILY_LIMIT=10
AI_MINUTE_LIMIT=10
REPORT_ATTEMPT_LIMIT=3
LOGIN_MINUTE_LIMIT=30
# Legacy Jina configuration, removed from web/search paths in task 2.4.
JINA_API_KEY=
# Missing Tavily credentials allow explicit unverified topic fallback.
# A URL without readable content still requires a topic or pasted text.
TAVILY_API_KEY=
QUIZ_GROUNDING_ENABLED=true
TOPIC_PREPARE_DAILY_LIMIT=20
TOPIC_PREPARE_TIMEOUT_SECONDS=240
GROUNDED_GENERATION_TIMEOUT_SECONDS=300
PREPARE_MODEL_CALL_LIMIT=5
GENERATION_MODEL_CALL_LIMIT=7
RETRIEVAL_MODEL_CALL_LIMIT=3
RETRIEVAL_TOOL_CALL_LIMIT=4
SEARCH_MAX_RESULTS=10
EXTRACT_MAX_URLS_PER_CALL=3
RETRIEVAL_MAX_PAGE_ATTEMPTS=12
TAVILY_TIMEOUT_SECONDS=20
TOOL_RESULT_MAX_BYTES=2097152
EVIDENCE_MAX_CHARS=24000
TOPIC_PREPARATION_TTL_HOURS=24
EVIDENCE_REUSE_SECONDS=1800
SOURCE_TIMEOUT_SECONDS=30
MATERIAL_MAX_BYTES=20971520
MATERIAL_MAX_CHARS=100000
MATERIAL_MAX_PAGES=200
MATERIAL_DAILY_LIMIT=20
PERIOD_DAILY_LIMIT=5

# Optional personal knowledge library. Beijing workspace endpoint from Bailian.
# Leave disabled until dependencies, migration, private storage and worker are ready.
KNOWLEDGE_ENABLED=false
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_BASE_URL=
KNOWLEDGE_EMBEDDING_REGION=cn-beijing
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v4
KNOWLEDGE_EMBEDDING_DIMENSION=1024
KNOWLEDGE_EMBEDDING_DISTANCE=cosine
# Absolute private directory; default is backend/knowledge-data.
# KNOWLEDGE_STORAGE_ROOT=D:/private/levelup-knowledge
KNOWLEDGE_EMBEDDING_DAILY_TOKENS=200000
KNOWLEDGE_IMPORT_DAILY_LIMIT=20
KNOWLEDGE_QUESTION_DAILY_LIMIT=20
KNOWLEDGE_MAX_DOCUMENTS=100
KNOWLEDGE_MAX_TOTAL_CHARS=5000000
KNOWLEDGE_WORKER_CONCURRENCY=2

# Optional question illustrations. User switch defaults OFF for every quiz.
# Empty IMAGE_API_KEY/IMAGE_BASE_URL reuse the Beijing KNOWLEDGE_EMBEDDING_* pair.
# They work independently of KNOWLEDGE_ENABLED; never use the DeepSeek endpoint.
QUIZ_IMAGES_ENABLED=true
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=qwen-image-2.0
IMAGE_SIZE=512*512
IMAGE_DAILY_LIMIT=20
IMAGE_CONCURRENCY=5
# Shared API/Worker dispatch pacing: Qwen Image 2.0 defaults to 2 requests/sec.
IMAGE_MIN_REQUEST_INTERVAL_SECONDS=0.55
IMAGE_TIMEOUT_SECONDS=60
IMAGE_STAGE_TIMEOUT_SECONDS=90
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15
IMAGE_UPLOAD_TIMEOUT_SECONDS=15
IMAGE_MAX_BYTES=8388608
# Bucket includes its APPID suffix, e.g. learning-images-1234567890.
# Use a dedicated public image prefix or an authorized CDN origin policy.
# HTTPS custom domain/CDN, without query parameters or an expiring signature.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_PUBLIC_BASE_URL=
