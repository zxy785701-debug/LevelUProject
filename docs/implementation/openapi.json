{
  "openapi": "3.1.0",
  "info": {
    "title": "LevelUp API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/quiz/generate": {
      "post": {
        "summary": "Quiz",
        "operationId": "quiz_api_v1_quiz_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/report/generate": {
      "post": {
        "summary": "Report",
        "operationId": "report_api_v1_report_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "question_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Question Id"
          },
          "selected": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Selected"
          },
          "elapsed_ms": {
            "type": "integer",
            "maximum": 86400000.0,
            "minimum": 0.0,
            "title": "Elapsed Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_id",
          "selected",
          "elapsed_ms"
        ],
        "title": "Answer"
      },
      "GenerateRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Text"
          },
          "question_count": {
            "type": "integer",
            "enum": [
              3,
              5
            ],
            "title": "Question Count",
            "default": 5
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium"
            ],
            "title": "Difficulty",
            "default": "easy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "GenerateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Option": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ],
            "title": "Id"
          },
          "text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "title": "Option"
      },
      "Question": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multi",
              "judge"
            ],
            "title": "Type"
          },
          "stem": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Stem"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 2,
            "title": "Options"
          },
          "answers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Answers"
          },
          "explanation": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Explanation"
          },
          "knowledge_point": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Knowledge Point"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "type",
          "stem",
          "options",
          "answers",
          "explanation",
          "knowledge_point"
        ],
        "title": "Question"
      },
      "Quiz": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Summary"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 3,
            "title": "Questions"
          },
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "source_text": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Source Text"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium"
            ],
            "title": "Difficulty"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "summary",
          "questions",
          "id",
          "created_at",
          "source_text",
          "difficulty"
        ],
        "title": "Quiz"
      },
      "ReportRequest": {
        "properties": {
          "quiz": {
            "$ref": "#/components/schemas/Quiz"
          },
          "answers": {
            "items": {
              "$ref": "#/components/schemas/Answer"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 3,
            "title": "Answers"
          },
          "mode": {
            "type": "string",
            "enum": [
              "new",
              "replay",
              "review"
            ],
            "title": "Mode",
            "default": "new"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quiz",
          "answers"
        ],
        "title": "ReportRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}